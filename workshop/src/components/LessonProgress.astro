---
import { chapters, curriculumVersion } from '../data/course';
import { nextChapterLink } from '../scripts/progress-state.mjs';
interface Props { lessonId: string }
const { lessonId } = Astro.props;
const chapter = chapters.find(chapter => chapter.id === lessonId);
if (!chapter) throw new Error(`Unknown lesson ${lessonId}`);
const next = nextChapterLink([], chapters, import.meta.env.BASE_URL, lessonId);
---
<section class="lesson-progress" data-lesson-progress data-progress-root data-id={lessonId} data-version={curriculumVersion} data-base={import.meta.env.BASE_URL} aria-label="Chapter completion">
  <div>
    <span class="eyebrow">Chapter {chapter.number} · {chapter.group}</span>
    <label><input type="checkbox" data-progress-toggle={lessonId} /> I completed this chapter and checked the result.</label>
    <p class="progress-status" data-progress-summary aria-live="polite"></p>
  </div>
  <a class="action-link" href={next.href} data-progress-next={lessonId}>{next.label}</a>
  <button class="secondary reset-progress" type="button" data-progress-reset>Clear this version's progress</button>
  <noscript>Saving progress needs JavaScript. You can still read every chapter and download its files.</noscript>
</section>
<script>
  import { connectProgress } from '../scripts/progress';
  connectProgress();
</script>
