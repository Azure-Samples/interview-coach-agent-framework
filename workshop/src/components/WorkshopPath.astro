---
import { chapterGroups, curriculumVersion, siteLink } from '../data/course';
---
<div data-progress-root data-base={import.meta.env.BASE_URL} data-version={curriculumVersion}>
  {chapterGroups.map(group => (
    <section class="course-path-group" aria-label={group.label}>
      <h3>{group.label}</h3>
      <ol class="course-path" start={group.chapters[0].number}>
        {group.chapters.map(({ id, number, title, description }) => (
          <li value={number}><a
            href={siteLink(`workshop/${id}/`)}
            data-progress-id={id}
            data-progress-label={`Chapter ${number}: ${title}`}
            aria-label={`Chapter ${number}: ${title}`}
          >
            <span class="path-number" aria-hidden="true">{number}</span>
            <div><strong>{title}</strong> <span class="workshop-completion">Completed</span><p>{description}</p></div>
            <span class="path-arrow" aria-hidden="true">→</span>
          </a></li>
        ))}
      </ol>
    </section>
  ))}
</div>
<script>
  import { connectProgress } from '../scripts/progress';
  connectProgress();
</script>
