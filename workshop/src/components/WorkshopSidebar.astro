---
import DefaultSidebar from '@astrojs/starlight/components/Sidebar.astro';
import { curriculumVersion } from '../data/course';
---
<div class="workshop-sidebar" data-progress-root data-base={import.meta.env.BASE_URL} data-version={curriculumVersion}>
  <p class="sidebar-progress" data-progress-summary aria-live="polite"></p>
  <DefaultSidebar />
</div>
<script>
  import { connectProgress } from '../scripts/progress';
  connectProgress();
</script>
