---
import ShellCommands from './ShellCommands.astro';
import contract from '../../.generated/edit-contract.json';
import { validateEditContract } from '../data/edit-contract.mjs';
import { siteLink } from '../data/course';

interface Props { transition: string }
const { transition } = Astro.props;
validateEditContract(contract);
const entry = contract.transitions.find(item => item.to === transition);
if (!entry?.steps.length || entry.steps.some(step => step.ownership !== 'supplied')) {
  throw new Error(`"${transition}" must contain only declared supplied-support edits.`);
}
const patch = `${transition}-support.patch`;
const commands = `git apply --check ./${patch}\ngit apply ./${patch}`;
---
<section class="checkpoint" data-supplied-transition={transition}>
  <strong>Finish the supplied hosting setup</strong>
  <p>This patch puts the hosting helper's code into the finished application and prepares its deployment entry point. Your coaching instructions stay as you wrote them.</p>
  <p><a href={siteLink(`downloads/${patch}`)} download>Download the supplied setup patch</a> into your working project's root, then run these commands from that folder:</p>
  <ShellCommands command={commands} />
  <p>Run the second command only when the check succeeds. If Git reports a conflict, keep your changes and compare the named file with the preceding checkpoint before trying again.</p>
  <details>
    <summary>Files changed by this required setup step</summary>
    <ul>{entry.steps.map(step => <li data-supplied-step={step.id}><code>{step.file}</code> ({step.operation === 'delete' ? 'remove workshop helper' : step.file.endsWith('AgentDelegateFactory.cs') ? 'update workflow comments' : 'update supplied hosting'})</li>)}</ul>
  </details>
</section>
