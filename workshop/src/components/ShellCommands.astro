---
import { Tabs, TabItem } from '@astrojs/starlight/components';
import SourceCode from './SourceCode.astro';

type Props =
  | { command: string; bash?: never; powershell?: never }
  | { command?: never; bash: string; powershell: string };

const { command, bash, powershell } = Astro.props;
---
<Tabs syncKey="shell">
  <TabItem label="Bash">
    <SourceCode code={command ?? bash} lang="bash" />
  </TabItem>
  <TabItem label="PowerShell">
    <SourceCode code={command ?? powershell} lang="powershell" />
  </TabItem>
</Tabs>
