---
type Kind = 'overview' | 'starter' | 'agent-run' | 'ag-ui' | 'tool-loop' | 'mcp-state' | 'documents' | 'handoffs'
  | 'interview-flow' | 'mcp-connection' | 'extraction' | 'first-handoff' | 'interviewers';
interface Props { kind: Kind }
interface Node {
  title: string;
  label: string[];
  detail: string;
  x: number;
  y: number;
  cloud?: boolean;
  tone?: 'context' | 'specialist';
}
interface Edge { from: number; to: number; fallback?: boolean; route?: [number, number][] }
interface Region { title: string; x: number; y: number; width: number; height: number }
interface Diagram { title: string; description: string; nodes: Node[]; edges: Edge[]; regions?: Region[]; note?: string }

const diagrams: Record<Kind, Diagram> = {
