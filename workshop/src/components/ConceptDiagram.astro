    description: 'Triage can select any specialist. The usual interview follows the specialist chain; each specialist can also return control to triage.',
    nodes: [
      { title: 'Triage', label: ['Routing; no domain tools'], detail: 'Starts the workflow. It can hand off to the receptionist, behavioural interviewer, technical interviewer, or summariser.', x: 265, y: 20, tone: 'specialist' },
      { title: 'Receptionist', label: ['Documents and records'], detail: 'Collects the resume and job description using MarkItDown and InterviewData. It can hand off to the behavioural interviewer or triage.', x: 15, y: 190, tone: 'context' },
      { title: 'Behavioural interviewer', label: ['InterviewData tools'], detail: 'Asks behavioural questions and saves feedback. It can hand off to the technical interviewer or triage.', x: 265, y: 190, tone: 'specialist' },
      { title: 'Technical interviewer', label: ['InterviewData tools'], detail: 'Asks technical questions and saves feedback. It can hand off to the summariser or triage.', x: 515, y: 190, tone: 'specialist' },
      { title: 'Summariser', label: ['InterviewData tools'], detail: 'Writes the final feedback, completes the interview record, and can hand control back to triage.', x: 515, y: 360, tone: 'context' }
    ],
    edges: [
      { from: 0, to: 1 }, { from: 0, to: 2 }, { from: 0, to: 3 },
      { from: 0, to: 4, route: [[475, 70], [735, 70], [735, 410], [725, 410]] },
      { from: 1, to: 2 }, { from: 2, to: 3 }, { from: 3, to: 4 },
      { from: 1, to: 0, fallback: true }, { from: 2, to: 0, fallback: true },
      { from: 3, to: 0, fallback: true, route: [[620, 190], [620, 145], [495, 145], [495, 90], [475, 90]] },
      { from: 4, to: 0, fallback: true, route: [[620, 460], [620, 475], [5, 475], [5, 70], [265, 70]] }
    ],
    note: 'All eleven handoff routes are shown. Dashed arrows return to triage. The agents take turns handling the conversation, using the same model deployment.'
  }
};

const { kind } = Astro.props;
const diagram = diagrams[kind];
if (!diagram) throw new Error(`Unknown teaching diagram: ${kind}`);
const width = 210;
const height = 100;
const graphicHeight = Math.max(
  ...diagram.nodes.map(node => node.y + height),
  ...(diagram.regions ?? []).map(region => region.y + region.height),
  ...diagram.edges.flatMap(edge => edge.route?.map(([, y]) => y) ?? [])
) + 20;
function connection(edge: Edge) {
  if (edge.route) {
    const points = edge.route;
    const [x, y] = points[points.length - 1];
    const [px, py] = points[points.length - 2];
    const length = Math.hypot(x - px, y - py);
    const ax = (x - px) / length;
    const ay = (y - py) / length;
    return {
      path: points.map(([a, b], index) => `${index === 0 ? 'M' : 'L'} ${a} ${b}`).join(' '),
      arrow: `${x},${y} ${x - ax * 10 + ay * 5},${y - ay * 10 - ax * 5} ${x - ax * 10 - ay * 5},${y - ay * 10 + ax * 5}`
    };
  }
  const from = diagram.nodes[edge.from];
  const to = diagram.nodes[edge.to];
  const dx = to.x - from.x;
  const dy = to.y - from.y;
  const scale = Math.min(dx === 0 ? Infinity : width / 2 / Math.abs(dx), dy === 0 ? Infinity : height / 2 / Math.abs(dy));
  const start = { x: from.x + width / 2 + dx * scale, y: from.y + height / 2 + dy * scale };
  const end = { x: to.x + width / 2 - dx * scale, y: to.y + height / 2 - dy * scale };
  const length = Math.hypot(dx, dy);
  const ux = dx / length;
  const uy = dy / length;
  const bend = edge.fallback ? 38 : 0;
  const control = { x: (start.x + end.x) / 2 - uy * bend, y: (start.y + end.y) / 2 + ux * bend };
  const angle = Math.atan2(end.y - control.y, end.x - control.x);
  const ax = Math.cos(angle);
  const ay = Math.sin(angle);
  return {
    path: `M ${start.x} ${start.y} Q ${control.x} ${control.y} ${end.x} ${end.y}`,
    arrow: `${end.x},${end.y} ${end.x - ax * 10 + ay * 5},${end.y - ay * 10 - ax * 5} ${end.x - ax * 10 - ay * 5},${end.y - ay * 10 + ax * 5}`
  };
}
---
<figure class="concept-diagram" data-diagram-kind={kind}>
  <figcaption>
    <strong>{diagram.title}</strong>
    <p>{diagram.description}</p>
  </figcaption>
  <svg class="concept-graphic" viewBox={`0 0 740 ${graphicHeight}`} aria-hidden="true" focusable="false">
    <title>{diagram.title}</title>
    <desc>{diagram.nodes.map(node => `${node.title}: ${node.detail}`).join(' ')}</desc>
    {diagram.regions?.map(region => (
      <g class="diagram-boundary">
        <rect x={region.x} y={region.y} width={region.width} height={region.height} rx="10" />
        <text x={region.x + 12} y={region.y + 27}>{region.title}</text>
      </g>
    ))}
    {diagram.edges.map(edge => {
      const drawing = connection(edge);
      return <g class:list={['diagram-edge', { 'diagram-fallback': edge.fallback }]} data-from={edge.from} data-to={edge.to}>
        <path d={drawing.path} />
        <polygon points={drawing.arrow} />
      </g>;
    })}
    {diagram.nodes.map(node => (
      <g class:list={['diagram-node', { 'diagram-cloud': node.cloud, 'diagram-context': node.tone === 'context', 'diagram-specialist': node.tone === 'specialist' }]} transform={`translate(${node.x},${node.y})`}>
        <rect width={width} height={height} rx="8" />
        <text x="105" y="36" text-anchor="middle" class="diagram-node-title">{node.title}</text>
        {node.label.map((line, index) => <text x="105" y={65 + index * 19} text-anchor="middle">{line}</text>)}
      </g>
    ))}
  </svg>
  <ol class="concept-text">
    {diagram.nodes.map(node => <li><strong>{node.title}.</strong> {node.detail}</li>)}
  </ol>
  {diagram.note && <p class="diagram-note">{diagram.note}</p>}
</figure>
