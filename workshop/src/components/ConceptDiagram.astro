      { title: 'Behavioural interviewer', label: ['InterviewData tools'], detail: 'Uses the saved context, asks behavioural questions, and saves feedback. It can hand off to the technical interviewer or triage.', x: 265, y: 190, tone: 'specialist' },
      { title: 'Technical interviewer', label: ['InterviewData tools'], detail: 'Asks technical questions and saves feedback. When the user finishes, it acknowledges the end without a handoff. An unexpected request can return to triage.', x: 515, y: 190, tone: 'specialist' }
